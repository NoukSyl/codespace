{
  "name": "Windows 11 Pro",
  "service": "windows",
  "containerEnv": {
    "VERSION": "11"
  },
  "forwardPorts": [5900, 3389],
  "portsAttributes": {
    "5900": {
      "label": "VNC",
      "onAutoForward": "notify"
    },
    "3389": {
      "label": "RDP",
      "onAutoForward": "ignore"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "dockerComposeFile": "codespaces.yml",
  "initializeCommand": "docker system prune --all --force",
  "postAttachCommand": "bash .devcontainer/setup-tailscale.sh"
}
