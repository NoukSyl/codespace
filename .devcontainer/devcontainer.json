{
  "name": "archlinux",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged",
    "--device=/dev/kvm",
    "--device=/dev/net/tun"
  ],
  "mounts": [
    "source=/var/run/docker-host.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/postStart.sh",
  "remoteUser": "vscode"
}