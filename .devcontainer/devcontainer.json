{
  "name": "arch-netbird-dockur",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "runArgs": [
    "--privileged",
    "--device=/dev/kvm",
    "--device=/dev/net/tun"
  ],

  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/postStart.sh",

  "remoteUser": "root"
}
